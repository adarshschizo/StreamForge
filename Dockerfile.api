FROM golang:1.22-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/streamforge-api ./apps/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/streamforge-api /streamforge-api
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/streamforge-api"]
