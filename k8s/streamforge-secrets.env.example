STREAMFORGE_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
STREAMFORGE_DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE?sslmode=require
STREAMFORGE_REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6380/0
STREAMFORGE_STORAGE_ACCESS_KEY=replace-with-storage-access-key
STREAMFORGE_STORAGE_SECRET_KEY=replace-with-storage-secret-key
