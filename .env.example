STREAMFORGE_API_ADDR=:8080
STREAMFORGE_ENV=development
STREAMFORGE_VERSION=0.1.0
STREAMFORGE_DATABASE_URL=postgres://streamforge:streamforge@127.0.0.1:5432/streamforge?sslmode=disable
STREAMFORGE_DATABASE_MODE=memory
STREAMFORGE_REDIS_URL=redis://localhost:6379/0
STREAMFORGE_STORAGE_ENDPOINT=http://127.0.0.1:9000
STREAMFORGE_STORAGE_ACCESS_KEY=minioadmin
STREAMFORGE_STORAGE_SECRET_KEY=minioadmin
STREAMFORGE_STORAGE_USE_SSL=false
STREAMFORGE_STORAGE_MODE=memory
STREAMFORGE_QUEUE_MODE=memory
STREAMFORGE_FFPROBE_PATH=ffprobe
STREAMFORGE_FFMPEG_PATH=ffmpeg
STREAMFORGE_PROCESSING_OUTPUT=./data/processed
STREAMFORGE_JWT_SECRET=replace-with-at-least-32-random-characters
STREAMFORGE_COOKIE_SECURE=false
STREAMFORGE_OTEL_ENABLED=false
STREAMFORGE_OTEL_SERVICE_NAME=streamforge
STREAMFORGE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
